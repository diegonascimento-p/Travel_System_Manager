PORT=3001
# Event mileage uses the free OpenStreetMap services; no API key or Google Cloud billing is needed.
# Identifies the app to Nominatim and OSRM, as Nominatim's usage policy requires. Put your app name
# and a contact (URL or email) here when you deploy it.
MAPS_USER_AGENT=TravelSystemManager/0.1 (+https://github.com/diegonascimento-p/Travel_System_Manager)
# Optional: point at self-hosted servers instead of the public ones.
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# OSRM_URL=https://router.project-osrm.org
# SQLite file holding the logged trips and user profiles; created and migrated on start.
DATABASE_PATH=data/travel.db
